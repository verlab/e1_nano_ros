<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>e1_core</name>
  <version>0.1.0</version>
  <description>ROS-independent core of the E1 Nano stack: Zenoh protocol, CF-Drone firmware model, position control, swarm client and MuJoCo/Genesis simulators</description>
  <maintainer email="verlab@dcc.ufmg.br">VeRLab</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>python3-numpy</exec_depend>
  <!-- pip: eclipse-zenoh==1.10.1 mujoco imageio imageio-ffmpeg (see requirements.txt) -->
  <exec_depend>e1_description</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
