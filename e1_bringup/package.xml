<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>e1_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for E1 Nano: simulation (MuJoCo/Genesis SITL), real swarm with motion capture, RViz</description>
  <maintainer email="verlab@dcc.ufmg.br">VeRLab</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>e1_core</exec_depend>
  <exec_depend>e1_description</exec_depend>
  <exec_depend>e1_bridge</exec_depend>
  <exec_depend>e1_control</exec_depend>
  <exec_depend>e1_mocap</exec_depend>
  <exec_depend>rmw_zenoh_cpp</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
