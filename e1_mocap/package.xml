<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>e1_mocap</name>
  <version>0.1.0</version>
  <description>OptiTrack (NatNet) motion capture for E1 Nano swarms: publishes one PoseStamped per drone in a Z-up world frame, no NatNet SDK needed.</description>
  <maintainer email="verlab@dcc.ufmg.br">VeRLab</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>e1_core</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
