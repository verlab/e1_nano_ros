<mujoco model="e1_nano">
  <!-- Cherglow E1 Nano v1.5Y (ESP32-S3 SuperMini) mini quadcopter, generated from the real PCB.
       Body frame FLU, origin = PCB centre / mid-plane. Wheelbase 50 mm, mass ~25 g.
       Actuators: thrust in newtons at each rotor (0..0.216 N ≈ 22 gf, ESTIMATED for 0716 coreless + 31 mm prop, 1S).
       Yaw reaction torque = kM/kF * thrust with kM/kF = 0.005 m; sign from spin direction.
       Actuator order = CF-Drone motor index: 0 RL(CCW), 1 RR(CW), 2 FR(CCW), 3 FL(CW). -->
  <compiler angle="radian" meshdir="../meshes/visual" inertiafromgeom="false" balanceinertia="true"/>
  <option timestep="0.001" density="1.204" viscosity="1.8e-5" integrator="implicitfast"/>
