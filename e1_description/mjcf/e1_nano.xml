  <default>
    <default class="vis"><geom type="mesh" contype="0" conaffinity="0" group="2" mass="0"/></default>
    <default class="col"><geom group="3" rgba="0.9 0.2 0.2 0.3" friction="0.8 0.02 0.001" solref="0.004 1" mass="0"/></default>
  </default>
